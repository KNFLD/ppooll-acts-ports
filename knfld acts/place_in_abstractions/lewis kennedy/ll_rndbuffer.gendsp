{
    "patcher": {
        "fileversion": 1,
        "appversion": {
            "major": 9,
            "minor": 1,
            "revision": 4,
            "architecture": "x64",
            "modernui": 1
        },
        "classnamespace": "dsp.gen",
        "rect": [ 134.0, 159.0, 446.0, 531.0 ],
        "subpatcher_template": "Default Max 7",
        "boxes": [
            {
                "box": {
                    "code": "// ===== RANDOM BUFFER GLITCH/CHOP ENGINE (properly randomized per instance) =====\n// in1 = single-sample impulse (from [click~] off a bang) triggers one glitch pass\n// live_buf = message inlet: send the name of a buffer~ in your patch to reference it\n// seed_offset = set to a DIFFERENT value on each duplicated instance (e.g. 0, 1, 2...)\n\nBuffer live_buf;\nParam seed_offset(0);\n\nHistory randseed(0.61803398875);\nHistory prevtrig(0);\n\ntrig = abs(in1) > 0.5;\nedge = trig && (prevtrig < 0.5);\nprevtrig = trig;\n\nbuflen = dim(live_buf);\nnumChannels = channels(live_buf);\n\nif (edge) {\n\tif (buflen > 100) {\n\t\trandseed = fract(randseed*1.6180339887 + 0.918273645 + seed_offset*0.3715209 + noise()*0.5);\n\t\tseverity = randseed;\n\n\t\trandseed = fract(randseed*1.37 + 0.29583 + seed_offset*0.117 + noise()*0.1);\n\t\tnumOps = 2 + floor(randseed*28);\n\n\t\tmaxChunkFrac = 0.01 + severity*0.14;\n\t\tmaxMuteSamples = maximum(20, floor(samplerate*0.008));\n\n\t\tfor (op = 0; op < numOps; op += 1) {\n\t\t\trandseed = fract(randseed*1.5137 + 0.7711 + op*0.0007 + seed_offset*0.0531);\n\t\t\topType = floor(randseed*4);\n\n\t\t\trandseed = fract(randseed*1.193 + 0.3312 + op*0.0011 + seed_offset*0.0713);\n\t\t\tstartPos = floor(randseed*buflen*0.9);\n\n\t\t\tavailSpace = buflen - startPos - 2;\n\n\t\t\tif (availSpace > 2) {\n\t\t\t\tchunkLen = 0;\n\n\t\t\t\tif (opType == 1) {\n\t\t\t\t\trandseed = fract(randseed*1.279 + 0.5521 + op*0.0013 + seed_offset*0.0397);\n\t\t\t\t\tchunkLen = 5 + floor(randseed*maxMuteSamples);\n\t\t\t\t} else {\n\t\t\t\t\trandseed = fract(randseed*1.279 + 0.5521 + op*0.0013 + seed_offset*0.0397);\n\t\t\t\t\tchunkLen = 20 + floor(randseed*buflen*maxChunkFrac);\n\t\t\t\t}\n\t\t\t\tchunkLen = minimum(chunkLen, availSpace);\n\n\t\t\t\tif (chunkLen > 2) {\n\t\t\t\t\tif (opType == 0) {\n\t\t\t\t\t\thalf = floor(chunkLen/2);\n\t\t\t\t\t\tfor (c = 0; c < numChannels; c += 1) {\n\t\t\t\t\t\t\tfor (j = 0; j < half; j += 1) {\n\t\t\t\t\t\t\t\tidxA = startPos + j;\n\t\t\t\t\t\t\t\tidxB = startPos + chunkLen - 1 - j;\n\t\t\t\t\t\t\t\tvalA = peek(live_buf, idxA, c);\n\t\t\t\t\t\t\t\tvalB = peek(live_buf, idxB, c);\n\t\t\t\t\t\t\t\tpoke(live_buf, valB, idxA, c);\n\t\t\t\t\t\t\t\tpoke(live_buf, valA, idxB, c);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\n\t\t\t\t\tif (opType == 1) {\n\t\t\t\t\t\tfor (c = 0; c < numChannels; c += 1) {\n\t\t\t\t\t\t\tfor (j = 0; j < chunkLen; j += 1) {\n\t\t\t\t\t\t\t\tpoke(live_buf, 0, startPos + j, c);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\n\t\t\t\t\tif (opType == 2) {\n\t\t\t\t\t\tsubLen = maximum(10, floor(chunkLen*0.125));\n\t\t\t\t\t\tfor (c = 0; c < numChannels; c += 1) {\n\t\t\t\t\t\t\tfor (j = 0; j < chunkLen; j += 1) {\n\t\t\t\t\t\t\t\tjmod = j - floor(j/subLen)*subLen;\n\t\t\t\t\t\t\t\tsrcIdx = startPos + jmod;\n\t\t\t\t\t\t\t\tval = peek(live_buf, srcIdx, c);\n\t\t\t\t\t\t\t\tpoke(live_buf, val, startPos + j, c);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\n\t\t\t\t\tif (opType == 3) {\n\t\t\t\t\t\trandseed = fract(randseed*1.411 + 0.221 + op*0.0017 + seed_offset*0.0281);\n\t\t\t\t\t\tholdLen = 2 + floor(randseed*10);\n\t\t\t\t\t\tfor (c = 0; c < numChannels; c += 1) {\n\t\t\t\t\t\t\tfor (j = 0; j < chunkLen; j += 1) {\n\t\t\t\t\t\t\t\tgroupStart = floor(j/holdLen)*holdLen;\n\t\t\t\t\t\t\t\tsrcIdx = startPos + groupStart;\n\t\t\t\t\t\t\t\tval = peek(live_buf, srcIdx, c);\n\t\t\t\t\t\t\t\tpoke(live_buf, val, startPos + j, c);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-5",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 50.0, 49.0, 340.0, 422.0 ]
                }
            },
