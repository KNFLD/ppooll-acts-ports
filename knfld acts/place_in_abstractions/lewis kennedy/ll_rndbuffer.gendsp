        "rect": [ 134.0, 159.0, 446.0, 531.0 ],
        "subpatcher_template": "Default Max 7",
        "boxes": [
            {
                "box": {
                    "code": "\nBuffer live_buf;\nParam seed_offset(0);\n\nHistory randseed(0.61803398875);\nHistory prevtrig(0);\n\nHistory opActive(0);       \nHistory opType(0);         \nHistory currentOp(0);      \nHistory totalOps(0);       \n\nHistory startPos(0);       \nHistory chunkLen(0);       \nHistory opCounter(0);      \nHistory maxChunkFrac(0);   \nHistory maxMuteSamples(0); \n\nHistory holdLen(1);        \nHistory subLen(1);         \n\ntrig = abs(in1) > 0.5;\nedge = trig && (prevtrig < 0.5);\nprevtrig = trig;\n\nbuflen = dim(live_buf);\nnumChannels = channels(live_buf);\n\nif (edge && buflen > 100 && opActive == 0) {\n    randseed = fract(randseed * 1.6180339887 + 0.918273645 + seed_offset * 0.3715209 + noise() * 0.5);\n    severity = randseed;\n\n    randseed = fract(randseed * 1.37 + 0.29583 + seed_offset * 0.117 + noise() * 0.1);\n    totalOps = 2 + floor(randseed * 28);\n    \n  \n    maxChunkFrac = 0.05 + severity * 0.20; \n    maxMuteSamples = maximum(20, floor(samplerate * 0.05));\n    \n    currentOp = 0;\n    opActive = 1;\n    opCounter = 0;\n    chunkLen = 0; \n}\n\n\nbatchSize = 512; \n\nif (opActive > 0) {\n    for (b = 0; b < batchSize; b += 1) {\n        \n      \n        if (opCounter >= chunkLen) {\n            if (currentOp >= totalOps) {\n                opActive = 0; \n                break;\n            } else {\n                randseed = fract(randseed * 1.5137 + 0.7711 + currentOp * 0.0007 + seed_offset * 0.0531);\n                opType = floor(randseed * 4);\n\n                randseed = fract(randseed * 1.193 + 0.3312 + currentOp * 0.0011 + seed_offset * 0.0713);\n               \n                startPos = floor(randseed * (buflen * 0.95));\n\n                availSpace = buflen - startPos - 2;\n\n                if (availSpace > 2) {\n                    randseed = fract(randseed * 1.279 + 0.5521 + currentOp * 0.0013 + seed_offset * 0.0397);\n                    \n                    if (opType == 1) {\n                        chunkLen = 25 + floor(randseed * maxMuteSamples);\n                    } else {\n                        chunkLen = 20 + floor(randseed * (buflen * maxChunkFrac));\n                    }\n                    chunkLen = minimum(chunkLen, availSpace);\n                    \n                    if (opType == 2) {\n                        subLen = maximum(10, floor(chunkLen * 0.125));\n                    }\n                    if (opType == 3) {\n                        randseed = fract(randseed * 1.411 + 0.221 + currentOp * 0.0017 + seed_offset * 0.0281);\n                        holdLen = 2 + floor(randseed * 10);\n                    }\n                    \n                    opCounter = 0; \n                    currentOp += 1; \n                } else {\n                    opActive = 0;\n                    break;\n                }\n            }\n        }\n\n        if (opActive > 0 && chunkLen > 2) {\n            \n           \n            if (opType == 0) {\n                half = floor(chunkLen / 2);\n                if (opCounter < half) {\n                    idxA = startPos + opCounter;\n                    idxB = startPos + chunkLen - 1 - opCounter;\n                    for (c = 0; c < numChannels; c += 1) {\n                        valA = peek(live_buf, idxA, c);\n                        valB = peek(live_buf, idxB, c);\n                        poke(live_buf, valB, idxA, c);\n                        poke(live_buf, valA, idxB, c);\n                    }\n                }\n            }\n\n\n            else if (opType == 1) {\n                for (c = 0; c < numChannels; c += 1) {\n                    poke(live_buf, 0, startPos + opCounter, c);\n                }\n            }\n\n           \n            else if (opType == 2) {\n                jmod = opCounter - floor(opCounter / subLen) * subLen;\n                srcIdx = startPos + jmod;\n                for (c = 0; c < numChannels; c += 1) {\n                    val = peek(live_buf, srcIdx, c);\n                    poke(live_buf, val, startPos + opCounter, c);\n                }\n            }\n\n          \n            else if (opType == 3) {\n                groupStart = floor(opCounter / holdLen) * holdLen;\n                srcIdx = startPos + groupStart;\n                for (c = 0; c < numChannels; c += 1) {\n                    val = peek(live_buf, srcIdx, c);\n                    poke(live_buf, val, startPos + opCounter, c);\n                }\n            }\n\n            opCounter += 1; \n        }\n    }\n}\n\nout1 = in1; \n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-5",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 50.0, 49.0, 340.0, 422.0 ]
                }
            },
